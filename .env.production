# =====================================================
# 운영 배포용 환경변수 (cafe24)
#   npm run build  →  이 파일이 자동 적용됩니다
#   npm run dev    →  .env.local 이 적용됩니다 (vite proxy 사용)
# =====================================================

# 사이트가 도메인 루트에 배포됨
VITE_BASE_URL=/

# 같은 도메인에 backend/ 가 함께 배포되므로 상대경로 사용 → CORS 없음
VITE_API_BASE_URL=/backend

# 업로드 파일도 같은 도메인 기준 상대경로
VITE_UPLOAD_BASE_URL=
